{
  "schemaVersion": 1,
  "id": "io.github.bjarkimg.android-tv-remote",
  "name": "Android TV Remote",
  "version": "1.2.1",
  "author": "Bjarki Már",
  "license": "MIT",
  "description": "Keyboard-driven Android TV / Google TV remote with discovery, PIN pairing, and Plex/Netflix/YouTube shortcuts. Works with NVIDIA SHIELD, Chromecast with Google TV, Google TV Streamer, and Android TV sets.",
  "homepage": "https://github.com/bjarkimg/omarchy-android-tv-remote",
  "repository": "https://github.com/bjarkimg/omarchy-android-tv-remote",
  "keywords": [
    "bar",
    "media",
    "remote",
    "android-tv",
    "google-tv",
    "shield"
  ],
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Android TV Remote",
    "description": "Remote for SHIELD, Chromecast with Google TV, Google TV Streamer, and Android TV sets",
    "category": "Controls",
    "defaultSection": "right",
    "allowMultiple": false,
    "defaults": {
      "deviceName": "Android TV",
      "host": ""
    },
    "schema": [
      {
        "key": "deviceName",
        "type": "string",
        "label": "Device name",
        "defaultValue": "Android TV"
      },
      {
        "key": "host",
        "type": "string",
        "label": "Device host (IP or hostname)",
        "defaultValue": ""
      }
    ]
  }
}
