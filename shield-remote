#!/bin/bash

set -euo pipefail

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CLIENT_HOME="$DATA_HOME/io.github.bjarkimg.shield-remote"
VENV="$CLIENT_HOME/venv"
CLIENT_PYTHON="$VENV/bin/python"
ANDROIDTVREMOTE2_VERSION="0.3.1"
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
SESSION_SCRIPT="${SHIELD_REMOTE_SESSION:-$SCRIPT_DIR/shield-remote-session.py}"
SHIELD_HOST="${SHIELD_HOST:-}"
SHIELD_NAME="${SHIELD_NAME:-SHIELD}"

usage() {
  cat <<'EOF'
Usage: shield-remote [--host HOST] [--name NAME] ACTION

Navigation:
  up down left right select back home menu

Playback and audio:
  play-pause previous next rewind ff volume-down volume-up

Power and status:
  wake sleep status

Apps:
  app-plex app-netflix app-youtube

Internal:
  session

Uses the Android TV Remote protocol (same as the Google TV phone app).
No ADB or developer mode. Pair with the 6-character code shown on the SHIELD.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  --host)
    [[ $# -ge 2 ]] || {
      echo "shield-remote: --host needs a value" >&2
      exit 2
    }
    SHIELD_HOST="$2"
    shift 2
    ;;
  --name)
    [[ $# -ge 2 ]] || {
      echo "shield-remote: --name needs a value" >&2
      exit 2
    }
    SHIELD_NAME="$2"
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  --)
    shift
    break
    ;;
  -*)
    echo "shield-remote: unknown option: $1" >&2
    usage >&2
    exit 2
    ;;
  *)
    break
    ;;
  esac
done

[[ $# -eq 1 ]] || {
  usage >&2
  exit 2
}

install_client() {
  if ! command -v python3 >/dev/null 2>&1; then
    echo "shield-remote: python3 is required" >&2
    return 1
  fi

  mkdir -p "$CLIENT_HOME"

  if [[ ! -x "$CLIENT_PYTHON" ]]; then
    echo "shield-remote: creating Python environment..." >&2
    python3 -m venv "$VENV"
  fi

  if ! "$CLIENT_PYTHON" -c \
    "import importlib.metadata as m, sys; sys.exit(m.version('androidtvremote2') != '$ANDROIDTVREMOTE2_VERSION')" \
    >/dev/null 2>&1; then
    echo "shield-remote: installing androidtvremote2 $ANDROIDTVREMOTE2_VERSION..." >&2
    "$CLIENT_PYTHON" -m pip install \
      --disable-pip-version-check \
      --quiet \
      "androidtvremote2==$ANDROIDTVREMOTE2_VERSION"
  fi
}

install_client

run_session() {
  if [[ ! -f "$SESSION_SCRIPT" ]]; then
    echo "shield-remote: session backend is missing: $SESSION_SCRIPT" >&2
    return 1
  fi

  exec "$CLIENT_PYTHON" "$SESSION_SCRIPT" --host "$SHIELD_HOST" --name "$SHIELD_NAME"
}

case "$1" in
session)
  run_session
  ;;
up | down | left | right | select | back | home | menu | play-pause | previous | next | rewind | ff | volume-down | volume-up | wake | sleep | status | app-plex | app-netflix | app-youtube)
  echo "shield-remote: one-shot actions run through the bar session" >&2
  exit 2
  ;;
*)
  echo "shield-remote: unknown action: $1" >&2
  usage >&2
  exit 2
  ;;
esac
